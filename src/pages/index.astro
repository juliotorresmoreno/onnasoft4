---
export const prerender = true;
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';
const { lang } = Astro.params;

const seo = {
    en: {
        title: "OnnaSoft | Technology Solutions for Businesses",
        description: "We help businesses solve real challenges through software engineering, cloud, system integration, AI, and technology consulting.",
    },
};

const currentSeo = seo[(lang as keyof typeof seo) ?? "en"] ?? seo.en;
---
<Layout
    title={currentSeo.title}
    description={currentSeo.description}
>
	<Welcome />
</Layout>
