---
export const prerender = true;
import Layout from "../../../../layouts/Layout.astro";
import Navbar from "../../../../components/Navbar/index.astro";
import Footer from "../../../../components/Footer.astro";
import Contact from "../../../../components/Contact.astro";

export function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "es" } },
        { params: { lang: "fr" } },
        { params: { lang: "ja" } },
        { params: { lang: "zh" } },
    ];
}

import ENLang from "./locales/en.astro";
import ESLang from "./locales/es.astro";
import FRLang from "./locales/fr.astro";
import JALang from "./locales/ja.astro";
import ZHLang from "./locales/zh.astro";

const { lang } = Astro.params;

const LangMap = {
    en: ENLang,
    es: ESLang,
    fr: FRLang,
    ja: JALang,
    zh: ZHLang,
} as const;

const selectedLang = (lang ?? "en") as keyof typeof LangMap;
const Lang = LangMap[selectedLang] ?? ENLang;

const seo = {
    en: {
        title: "Custom Software Development Process | OnnaSoft",
        description: "See how OnnaSoft builds custom solutions: understanding your business, designing the right architecture, developing, testing, deploying and supporting your software.",
    },
    es: {
        title: "Proceso de Desarrollo de Software a Medida | OnnaSoft",
        description: "Conoce cómo OnnaSoft crea soluciones a medida: análisis de tu negocio, diseño de la arquitectura adecuada, desarrollo, pruebas, despliegue y soporte continuo.",
    },
    fr: {
        title: "Processus de développement logiciel sur mesure | OnnaSoft",
        description: "Découvrez comment OnnaSoft conçoit des solutions sur mesure : analyse de votre activité, architecture adaptée, développement, tests, déploiement et accompagnement.",
    },
    ja: {
        title: "オーダーメイド開発のプロセス｜OnnaSoftの進め方",
        description: "OnnaSoftがオーダーメイドソリューションを構築する流れをご紹介します。業務理解、設計、開発、テスト、導入、継続的なサポートまで段階的に進めます。",
    },
    zh: {
        title: "定制软件开发流程 | OnnaSoft 的解决方案构建方法",
        description: "了解 OnnaSoft 如何分步构建定制解决方案：深入了解业务、设计合适架构、开发、测试、部署并持续提供支持。",
    },
};

const currentSeo = seo[(lang as keyof typeof seo) ?? "en"] ?? seo.en;
---
<Layout
    title={currentSeo.title}
    description={currentSeo.description}
>
    <div id="container">
        <Navbar />
        <main
            style="margin-top: 80px; padding: 0 20px; max-width: 800px; margin-left: auto; margin-right: auto;"
        >
            <Lang />
        </main>
        <Contact />
        <Footer />
    </div>
</Layout>
<style></style>
