---
import Layout from "../../../../layouts/Layout.astro";
import Navbar from "../../../../components/Navbar/index.astro";
import Footer from "../../../../components/Footer.astro";
import Contact from "../../../../components/Contact.astro";

export function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "es" } },
        { params: { lang: "fr" } },
        { params: { lang: "ja" } },
        { params: { lang: "zh" } },
    ];
}

import ENLang from "./locales/en.astro";
import ESLang from "./locales/es.astro";
import FRLang from "./locales/fr.astro";
import JALang from "./locales/ja.astro";
import ZHLang from "./locales/zh.astro";

const { lang } = Astro.params;

const LangMap = {
    en: ENLang,
    es: ESLang,
    fr: FRLang,
    ja: JALang,
    zh: ZHLang,
} as const;

const selectedLang = (lang ?? "en") as keyof typeof LangMap;
const Lang = LangMap[selectedLang] ?? ENLang;

const seo = {
    en: {
        title: "Digital Transformation & Development Services | OnnaSoft",
        description: "Build, connect and modernize your business with OnnaSoft's development and digital transformation services, from custom applications to legacy system modernization.",
    },
    es: {
        title: "Desarrollo y Transformación Digital | Servicios OnnaSoft",
        description: "Construye, conecta y moderniza tu negocio con los servicios de desarrollo y transformación digital de OnnaSoft, desde aplicaciones a medida hasta la modernización de sistemas heredados.",
    },
    fr: {
        title: "Développement et Transformation Digitale | Services OnnaSoft",
        description: "Construisez, connectez et modernisez votre entreprise avec les services de développement et de transformation digitale d'OnnaSoft, des applications sur mesure à la modernisation des systèmes existants.",
    },
    ja: {
        title: "開発・デジタルトランスフォーメーションサービス｜OnnaSoft",
        description: "アプリ開発からレガシーシステムの刷新まで、OnnaSoftの開発・DXサービスでビジネスの構築、連携、近代化を進めます。",
    },
    zh: {
        title: "开发与数字化转型服务 | OnnaSoft",
        description: "借助 OnnaSoft 的开发与数字化转型服务，从定制应用到遗留系统现代化，帮助您构建、连接并革新业务。",
    },
};

const currentSeo = seo[(lang as keyof typeof seo) ?? "en"] ?? seo.en;
---
<Layout
    title={currentSeo.title}
    description={currentSeo.description}
>
    <div id="container">
        <Navbar />
        <main
            style="margin-top: 80px; padding: 0 20px; max-width: 800px; margin-left: auto; margin-right: auto;"
        >
            <Lang />
        </main>
        <Contact />
        <Footer />
    </div>
</Layout>
<style></style>
