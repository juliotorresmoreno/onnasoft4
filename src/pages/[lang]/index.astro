---
import Welcome from "../../components/Welcome.astro";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
	return [
		{ params: { lang: "en" } },
		{ params: { lang: "es" } },
		{ params: { lang: "fr" } },
		{ params: { lang: "ja" } },
		{ params: { lang: "zh" } },
	];
}

const { lang } = Astro.params;
---

<Layout>
	<Welcome />
</Layout>
