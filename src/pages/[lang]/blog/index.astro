---
import Layout from "../../../layouts/Layout.astro";
export function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "es" } },
        { params: { lang: "fr" } },
        { params: { lang: "ja" } },
        { params: { lang: "zh" } },
    ];
}

const { lang } = Astro.params;

const seo = {
    en: {
        title: "OnnaSoft Blog | Software, Cloud, AI & Digital Transformation Insights",
        description: "Read OnnaSoft articles on software engineering, cloud infrastructure, AI, data engineering, Odoo and digital transformation for growing businesses.",
    },
    es: {
        title: "Blog de OnnaSoft | Software, Cloud, IA y Transformación Digital",
        description: "Artículos de OnnaSoft sobre ingeniería de software, infraestructura cloud, IA, ingeniería de datos, Odoo y transformación digital para empresas en crecimiento.",
    },
    fr: {
        title: "Blog OnnaSoft | Logiciel, Cloud, IA et Transformation Digitale",
        description: "Articles d'OnnaSoft sur l'ingénierie logicielle, l'infrastructure cloud, l'IA, l'ingénierie des données, Odoo et la transformation digitale pour les entreprises en croissance.",
    },
    ja: {
        title: "OnnaSoftブログ｜ソフトウェア・クラウド・AI・DXの最新情報",
        description: "ソフトウェア開発、クラウドインフラ、AI、データエンジニアリング、Odoo、デジタルトランスフォーメーションに関するOnnaSoftの記事をご覧ください。",
    },
    zh: {
        title: "OnnaSoft 博客 | 软件、云计算、人工智能与数字化转型洞察",
        description: "阅读 OnnaSoft 关于软件工程、云基础设施、人工智能、数据工程、Odoo 及数字化转型的文章，助力企业持续增长。",
    },
};

const currentSeo = seo[(lang as keyof typeof seo) ?? "en"] ?? seo.en;
---
<Layout
    title={currentSeo.title}
    description={currentSeo.description}
>
<div>blog</div>
</Layout>
