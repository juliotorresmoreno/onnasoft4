---
export const prerender = true;
import Layout from "../../../../layouts/Layout.astro";
import Navbar from "../../../../components/Navbar/index.astro";
import Footer from "../../../../components/Footer.astro";
import Contact from "../../../../components/Contact.astro";

export function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "es" } },
        { params: { lang: "fr" } },
        { params: { lang: "ja" } },
        { params: { lang: "zh" } },
    ];
}

import ENLang from "./locales/en.astro";
import ESLang from "./locales/es.astro";
import FRLang from "./locales/fr.astro";
import JALang from "./locales/ja.astro";
import ZHLang from "./locales/zh.astro";

const { lang } = Astro.params;

const LangMap = {
    en: ENLang,
    es: ESLang,
    fr: FRLang,
    ja: JALang,
    zh: ZHLang,
} as const;

const selectedLang = (lang ?? "en") as keyof typeof LangMap;
const Lang = LangMap[selectedLang] ?? ENLang;

const seo = {
    en: {
        title: "IT Outsourcing Services | Specialized Developers for Your Team",
        description: "Expand your team with specialized IT outsourcing talent. OnnaSoft provides skilled developers to scale projects, reduce hiring overhead and accelerate delivery.",
    },
    es: {
        title: "Outsourcing de TI | Amplía tu equipo con talento especializado",
        description: "Amplía tu equipo con talento especializado en outsourcing de TI. OnnaSoft aporta desarrolladores cualificados para escalar proyectos, reducir costes de contratación y acelerar entregas.",
    },
    fr: {
        title: "Externalisation informatique | Développez votre équipe avec des experts",
        description: "Renforcez votre équipe grâce à l'externalisation informatique d'OnnaSoft : talents spécialisés, montée en charge flexible, réduction des coûts de recrutement et livraison accélérée.",
    },
    ja: {
        title: "ITアウトソーシングサービス｜専門人材でチームを拡張",
        description: "ITアウトソーシングで専門性の高い人材を確保し、開発チームを柔軟に拡張します。OnnaSoftが、プロジェクトの加速と採用コスト削減を支援します。",
    },
    zh: {
        title: "IT 外包服务 | 以专业人才扩展您的团队",
        description: "借助 OnnaSoft 的 IT 外包服务快速扩展开发团队，获取专业技术人才，灵活应对项目需求，降低招聘成本并加快交付。",
    },
};

const currentSeo = seo[(lang as keyof typeof seo) ?? "en"] ?? seo.en;
---
<Layout
    title={currentSeo.title}
    description={currentSeo.description}
>
    <div id="container">
        <Navbar />
        <main
            style="margin-top: 80px; padding: 0 20px; max-width: 800px; margin-left: auto; margin-right: auto;"
        >
            <Lang />
        </main>
        <Contact />
        <Footer />
    </div>
</Layout>
<style></style>
