---
import Layout from "../../../layouts/Layout.astro";
import Navbar from "../../../components/Navbar/index.astro";
import Footer from "../../../components/Footer.astro";
import Contact from "../../../components/Contact.astro";

export function getStaticPaths() {
    return [
        { params: { lang: "en" } },
        { params: { lang: "es" } },
        { params: { lang: "fr" } },
        { params: { lang: "ja" } },
        { params: { lang: "zh" } },
    ];
}

const { lang } = Astro.params;

---

<Layout>
    <div id="container">
        <Navbar />
        <main
            style="margin-top: 80px; padding: 0 20px; max-width: 800px; margin-left: auto; margin-right: auto;"
        >
        </main>
        <Contact />
        <Footer />
    </div>
</Layout>
<style></style>
