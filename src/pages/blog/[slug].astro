---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar/index.astro";
import Footer from "../../components/Footer.astro";
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";

const { slug } = Astro.params;

const { entry: post } = await getEmDashEntry("posts", slug ?? "");

if (!post) {
    Astro.response.status = 404;
}

const image = post?.data.featured_image;
const imageUrl = image?.src ?? image?.previewUrl;

const title = post ? `${post.data.title} | OnnaSoft Blog` : "Blog | OnnaSoft";
const description =
    "Read the latest OnnaSoft article on software, cloud, AI and digital transformation.";
---

<Layout title={title} description={description}>
    <div id="container">
        <Navbar />
        <main class="mt-20 w-full px-5 md:px-10 space-y-8 pb-8">
            <a href="/blog" class="text-sm text-primary hover:underline">← Back to blog</a>

            {post ? (
                <article class={`grid items-start gap-8 ${imageUrl ? "md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]" : ""}`}>
                    {imageUrl && (
                        <figure class="m-0">
                            <img
                                src={imageUrl}
                                alt={image?.alt ?? ""}
                                width={image?.width}
                                height={image?.height}
                                class="w-full h-auto rounded-lg object-cover"
                            />
                        </figure>
                    )}
                    <div class="min-w-0 space-y-6 text-gray-700 leading-8">
                        <h1 class="text-4xl font-bold leading-tight text-gray-900">{post.data.title}</h1>
                        <PortableText value={post.data.content} />
                    </div>
                </article>
            ) : (
                <p class="text-gray-600">This article could not be found.</p>
            )}
        </main>
        <Footer />
    </div>
</Layout>
