---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar/index.astro";
import Footer from "../../components/Footer.astro";
import { getEmDashCollection } from "emdash";

const title = "OnnaSoft Pages";
const description = "Pages published by OnnaSoft.";

const { entries: pages } = await getEmDashCollection("pages", {
    status: "published",
});
---

<Layout title={title} description={description}>
    <div id="container">
        <Navbar />
        <main class="mt-20 px-5 max-w-3xl mx-auto space-y-8">
            <h1 class="text-4xl font-bold text-gray-900">Pages</h1>

            {pages.length === 0 ? (
                <p class="text-gray-600">No pages published yet.</p>
            ) : (
                <ul class="space-y-4">
                    {pages.map((page) => (
                        <li>
                            <a
                                href={`/pages/${page.data.slug}`}
                                class="text-xl font-semibold text-primary hover:underline"
                            >
                                {page.data.title}
                            </a>
                        </li>
                    ))}
                </ul>
            )}
        </main>
        <Footer />
    </div>
</Layout>
