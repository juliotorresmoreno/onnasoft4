---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar/index.astro";
import Footer from "../../components/Footer.astro";
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";

const { slug } = Astro.params;

const { entry: page } = await getEmDashEntry("pages", slug ?? "");

if (!page) {
    Astro.response.status = 404;
}

const title = page ? `${page.data.title} | OnnaSoft` : "Page not found | OnnaSoft";
const description = "OnnaSoft page.";
---

<Layout title={title} description={description}>
    <div id="container">
        <Navbar />
        <main class="mt-20 px-5 max-w-3xl mx-auto space-y-8">
            {page ? (
                <article class="space-y-6 text-gray-700 leading-8">
                    <h1 class="text-4xl font-bold leading-tight text-gray-900">{page.data.title}</h1>
                    <PortableText value={page.data.content} />
                </article>
            ) : (
                <p class="text-gray-600">This page could not be found.</p>
            )}
        </main>
        <Footer />
    </div>
</Layout>
