---
import "../styles/global.css";
import SEO from "../components/SEO.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "OnnaSoft | Technology Solutions for Businesses",
	description = "We help businesses solve real challenges through software engineering, cloud, system integration, AI, and technology consulting.",
} = Astro.props;

const { lang } = Astro.params;
---

<!doctype html>
<html lang={lang ?? "en"}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<SEO title={title} description={description} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
