// Same order as items above.
const hrefs = [
    "/software-engineering/software-engineering-custom-scalable-software-solutions-for-your-business",
    "/cloud-devops/cloud-and-devops-automated-reliable-and-optimized-infrastructure",
    "/system-integration/system-integration-connect-your-platforms-and-exchange-data-seamlessly",
    "/ai-data-engineering/ai-and-data-engineering-turn-your-data-into-intelligent-automation",
    "/technology-consulting/technology-consulting-strategy-architecture-and-digital-transformation",
    "/technical-talent-solutions/technical-talent-solutions-hire-specialized-developers-and-tech-talent",
];

// Same order as items above.
const icons = [
    "fa-code",
    "fa-cloud",
    "fa-plug",
    "fa-brain",
    "fa-lightbulb",
    "fa-users-gear",
];

const [, language, ...segments] = Astro.url.pathname.split("/");

const t =
    translations[language as keyof typeof translations] || translations.en;
const lang = language in translations ? language : "en";
---

<div class="relative group">
    <button class="flex items-center nav-link group-hover:text-primary">
        {t.services}
        <svg
            class="ml-2 h-4 w-4 transition-transform duration-300 group-hover:rotate-180"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width={2}
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path>
        </svg>
    </button>
    <div
        class="absolute z-10 mt-1 left-1/2 transform -translate-x-1/2 min-w-[650px] rounded-md shadow-lg bg-white ring-1 ring-slate-200 ring-opacity-5 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300"
    >
        <div class="grid grid-cols-2 p-2">
            {
                t.items.map((item, i) => (
                    <a
                        href={`/${lang}${hrefs[i]}`}
                        class="flex items-start gap-3 px-4 py-2 hover:bg-gray-100"
                        role="menuitem"
                    >
                        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-primary">
                            <i class={`fa-solid ${icons[i]}`} aria-hidden="true"></i>
                        </span>
                        <div>
                            <div class="text-gray-900 font-medium">{item.name}</div>
                            <div class="text-gray-500 text-sm">
                                {item.description}
                            </div>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</div>