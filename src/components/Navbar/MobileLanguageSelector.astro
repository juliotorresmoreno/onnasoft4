---
const [, language] = Astro.url.pathname.split("/");
const query = Astro.url.searchParams.get("q") || "";
---

<div class="relative mr-4">
    <select
        data-language-selector
        class="bg-white border border-gray-300 rounded-md px-2 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-primary appearance-none pr-8"
        value={language}
        aria-label="Select language"
    >
        <option value="en">🇺🇸 EN</option>
        <option value="es">🇪🇸 ES</option>
        <option value="fr">🇫🇷 FR</option>
        <option value="ja">🇯🇵 JA</option>
        <option value="zh">🇨🇳 ZH</option>
    </select>
    <div
        class="absolute inset-y-0 right-0 flex items-center pr-2 pointer-events-none"
    >
        <svg
            class="w-4 h-4 text-gray-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
        </svg>
    </div>
</div>

<script>
    const select = document.querySelector("[data-language-selector]");

    if (select instanceof HTMLSelectElement) {
        select.addEventListener("change", (event) => {
            const target = event.currentTarget;

            if (!(target instanceof HTMLSelectElement)) {
                return;
            }

            const newLang = target.value;
            const currentPath = window.location.pathname;
            const langRegex = /^(en|es|fr|ja|zh)(\/|$)/;
            const basePath = "/" + newLang;
            const searchParams = new URLSearchParams(window.location.search);
            const queryValue = searchParams.get("q") || "";
            const newPath = langRegex.test(currentPath)
                ? currentPath.replace(langRegex, basePath + "$2")
                : basePath + currentPath;
            const newUrl = newPath + (queryValue ? `?q=${queryValue}` : "");

            window.location.href = newUrl;
        });
    }
</script>
