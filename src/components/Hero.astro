---
const { language = Astro.url.pathname.split("/").filter(Boolean)[0] || "en" } =
  Astro.props;

const translations = {
  en: {
    eyebrow: "Technology Engineering",
    title: "Technology that moves your business forward.",
    subtitle:
      "We build software, connect systems and engineer technology solutions that solve real business problems — designed to grow and evolve with your business.",
    statement: "Fast to build. Solid to grow. Flexible to evolve.",
    ctaPrimary: "Contact OnnaSoft",
    ctaSecondary: "Explore our work",
    stackLabel: "Technologies we build solutions with",
  },
  es: {
    eyebrow: "Technology Engineering",
    title: "Tecnología que impulsa tu negocio.",
    subtitle:
      "Construimos software, conectamos sistemas y diseñamos soluciones tecnológicas que resuelven problemas reales de negocio — pensadas para crecer y evolucionar contigo.",
    statement:
      "Rápido de construir. Sólido para crecer. Flexible para evolucionar.",
    ctaPrimary: "Contacta a OnnaSoft",
    ctaSecondary: "Explora nuestro trabajo",
    stackLabel: "Tecnologías con las que construimos soluciones.",
  },
  fr: {
    eyebrow: "Technology Engineering",
    title: "La technologie qui fait avancer votre entreprise.",
    subtitle:
      "Nous construisons des logiciels, connectons des systèmes et concevons des solutions technologiques qui résolvent de vrais problèmes métier — pensées pour grandir et évoluer avec vous.",
    statement:
      "Rapide à construire. Solide pour grandir. Flexible pour évoluer.",
    ctaPrimary: "Contactez OnnaSoft",
    ctaSecondary: "Découvrez notre travail",
    stackLabel: "Technologies avec lesquelles nous construisons des solutions",
  },
  ja: {
    eyebrow: "Technology Engineering",
    title: "ビジネスを前進させるテクノロジー。",
    subtitle:
      "私たちは、実際のビジネス課題を解決するソフトウェアを構築し、システムを接続し、テクノロジーソリューションを設計します — ビジネスとともに成長し、進化するように作られています。",
    statement: "素早く構築。堅牢に成長。柔軟に進化。",
    ctaPrimary: "OnnaSoftに連絡",
    ctaSecondary: "実績を見る",
    stackLabel: "ソリューションを構築する技術",
  },
  zh: {
    eyebrow: "Technology Engineering",
    title: "推动业务前进的技术。",
    subtitle:
      "我们构建软件、连接系统并设计解决真实业务问题的技术方案 — 旨在随业务一同成长与演进。",
    statement: "快速构建。稳健成长。灵活演进。",
    ctaPrimary: "联系 OnnaSoft",
    ctaSecondary: "查看我们的作品",
    stackLabel: "我们构建解决方案所用的技术",
  },
};

const t =
  translations[language as keyof typeof translations] ?? translations.en;

type TechIcon =
  | { type: "fa"; icon: string; color: string; title: string }
  | { type: "svg"; src: string; title: string }
  | { type: "inline"; svg: string; title: string };

const techIcons: TechIcon[] = [
  {
    type: "svg",
    src: "https://cdn.simpleicons.org/typescript/3178C6",
    title: "TypeScript",
  },
  {
    type: "svg",
    src: "https://cdn.simpleicons.org/python/3776AB",
    title: "Python",
  },
  { type: "svg", src: "https://cdn.simpleicons.org/go/00ADD8", title: "Go" },
  {
    type: "fa",
    icon: "fab fa-node-js",
    color: "text-green-600",
    title: "Node.js",
  },
  { type: "fa", icon: "fab fa-react", color: "text-blue-400", title: "React" },
  {
    type: "svg",
    src: "https://cdn.simpleicons.org/nextdotjs/000000",
    title: "Next.js",
  },
  {
    type: "svg",
    src: "https://cdn.simpleicons.org/postgresql/4169E1",
    title: "PostgreSQL",
  },
  {
    type: "svg",
    src: "https://cdn.simpleicons.org/apachespark/E25A1C",
    title: "Apache Spark",
  },
  { type: "fa", icon: "fab fa-aws", color: "text-orange-500", title: "AWS" },
  {
    type: "fa",
    icon: "fab fa-docker",
    color: "text-blue-600",
    title: "Docker",
  },
  {
    type: "fa",
    icon: "fab fa-kubernetes",
    color: "text-blue-600",
    title: "Kubernetes",
  },
];
---

<section
  id="home"
  class="hero-pattern relative isolate flex min-h-screen flex-col overflow-hidden"
  aria-labelledby="hero-title"
>
  <div
    class="hero-grid pointer-events-none absolute inset-0"
    aria-hidden="true"
  ></div>
  <div class="absolute inset-0 bg-linear-to-br from-white via-primary/10 to-fuchsia-50"></div>
  <div
    class="hero-orb hero-orb-one pointer-events-none absolute -top-48 right-[-12%] h-[680px] w-[680px] rounded-full"
    aria-hidden="true"
  ></div>
  <div
    class="hero-orb hero-orb-two pointer-events-none absolute bottom-[-18rem] left-[-12rem] h-[520px] w-[520px] rounded-full"
    aria-hidden="true"
  ></div>
  <div
    class="hero-noise pointer-events-none absolute inset-0"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 mx-auto grid w-full max-w-7xl flex-1 grid-cols-1 items-center gap-12 px-6 py-20 sm:px-8 lg:grid-cols-12 lg:gap-8 lg:py-24">
    <div class="lg:col-span-6 xl:col-span-6">
      <p class="hero-fade hero-fade-1 mb-5 inline-flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-primary uppercase">
        <span class="live-dot" aria-hidden="true"></span>
        {t.eyebrow}
      </p>

      <h1
        id="hero-title"
        class="hero-fade hero-fade-2 max-w-3xl text-4xl font-semibold leading-[1.04] tracking-tight text-slate-950 sm:text-5xl lg:text-[3.75rem] xl:text-6xl"
      >
        <span class="title-shimmer">{t.title}</span>
      </h1>

      <p class="hero-fade hero-fade-3 mt-6 max-w-xl text-base leading-relaxed text-slate-600 sm:text-lg">
        {t.subtitle}
      </p>

      <div class="hero-fade hero-fade-4 mt-9 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
        <a
          href={`/${language}/contact`}
          class="button-primary group inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-7 py-3.5 text-sm font-semibold text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          <span>{t.ctaPrimary}</span>
          <span
            class="transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true"
          >
            →
          </span>
        </a>
        <a
          href={`/${language}/work`}
          class="button-secondary group inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200/80 bg-white/65 px-7 py-3.5 text-sm font-semibold text-slate-800 backdrop-blur-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          <span>{t.ctaSecondary}</span>
          <span
            class="text-primary transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true"
          >
            ↗
          </span>
        </a>
      </div>

      <p class="hero-fade hero-fade-5 mt-10 max-w-md text-sm font-medium tracking-wide text-slate-500">
        <span class="mr-2 text-primary" aria-hidden="true">
          ✦
        </span>
        {t.statement}
      </p>
    </div>

    <div class="lg:col-span-6 xl:col-span-6">
      <div
        class="hero-visual relative mx-auto max-w-[580px]"
        aria-label="Interactive modular software architecture diagram"
      >
        <div class="visual-badge visual-badge-top">SYSTEMS / 01</div>
        <div class="visual-badge visual-badge-bottom">
          BUILD · CONNECT · EVOLVE
        </div>
        <div class="visual-glow" aria-hidden="true"></div>

        <svg
          viewBox="0 0 600 560"
          role="img"
          aria-label="Isometric diagram of a modular software architecture"
          class="architecture-svg relative z-10 h-auto w-full overflow-visible"
        >
          <defs>
            <linearGradient id="gradPink" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#f9a8d4" />
              <stop offset="100%" stop-color="#ec4899" />
            </linearGradient>
            <linearGradient id="gradMagenta" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#ec4899" />
              <stop offset="100%" stop-color="#be185d" />
            </linearGradient>
            <linearGradient id="gradWhite" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#ffffff" />
              <stop offset="100%" stop-color="#fce7f3" />
            </linearGradient>
            <linearGradient id="gradNeutral" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f8fafc" />
              <stop offset="100%" stop-color="#e2e8f0" />
            </linearGradient>
            <filter
              id="softShadow"
              x="-30%"
              y="-30%"
              width="160%"
              height="180%"
            >
              <feDropShadow
                dx="0"
                dy="14"
                stdDeviation="12"
                flood-color="#be185d"
                flood-opacity="0.14"
              />
            </filter>
            <filter
              id="pinkGlow"
              x="-100%"
              y="-100%"
              width="300%"
              height="300%"
            >
              <feGaussianBlur stdDeviation="5" />
            </filter>
          </defs>

          <g
            class="ambient-rings"
            fill="none"
            stroke="#ec4899"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <ellipse
              class="orbit orbit-one"
              cx="300"
              cy="302"
              rx="204"
              ry="112"
              stroke-width="1"
              stroke-dasharray="2 13"
              opacity=".24"
            />
            <ellipse
              class="orbit orbit-two"
              cx="300"
              cy="302"
              rx="148"
              ry="82"
              stroke-width="1.5"
              stroke-dasharray="1 17"
              opacity=".2"
            />
            <circle
              class="core-ring core-ring-one"
              cx="300"
              cy="270"
              r="65"
              stroke-width="1"
              opacity=".22"
            />
            <circle
              class="core-ring core-ring-two"
              cx="300"
              cy="270"
              r="78"
              stroke-width="1"
              opacity=".12"
            />
          </g>
          <g class="floating-modules" aria-hidden="true">
            <g class="float-module float-module-api">
              <rect
                x="72"
                y="188"
                width="108"
                height="30"
                rx="8"
                fill="rgba(255,255,255,.84)"
                stroke="#f9a8d4"
                stroke-width="1"
              />
              <circle cx="86" cy="203" r="4" fill="#ec4899" />
              <text x="98" y="206" fill="#9d174d">
                SOFTWARE
              </text>
            </g>
            <g class="float-module float-module-data">
              <rect
                x="82"
                y="391"
                width="82"
                height="30"
                rx="8"
                fill="rgba(255,255,255,.78)"
                stroke="#cbd5e1"
                stroke-width="1"
              />
              <circle cx="95" cy="406" r="4" fill="#3b82f6" />
              <text x="107" y="409" fill="#475569">
                DATA
              </text>
            </g>
            <g class="float-module float-module-cloud">
              <rect
                x="450"
                y="319"
                width="112"
                height="30"
                rx="8"
                fill="rgba(255,255,255,.84)"
                stroke="#f9a8d4"
                stroke-width="1"
              />
              <circle cx="464" cy="334" r="4" fill="#ec4899" />
              <text x="476" y="337" fill="#9d174d">
                INTEGRATIONS
              </text>
            </g>
            <g class="float-module float-module-sec">
              <rect
                x="440"
                y="92"
                width="88"
                height="30"
                rx="8"
                fill="rgba(255,255,255,.84)"
                stroke="#f9a8d4"
                stroke-width="1"
              />
              <circle cx="454" cy="107" r="4" fill="#ec4899" />
              <text x="466" y="110" fill="#9d174d">
                INFRA
              </text>
            </g>
          </g>
          <ellipse
            cx="300"
            cy="478"
            rx="168"
            ry="28"
            fill="#ec4899"
            opacity="0.12"
            filter="url(#pinkGlow)"
          />
          <g
            class="connections"
            stroke="#ec4899"
            stroke-width="1.7"
            fill="none"
            stroke-linecap="round"
            opacity="0.7"
          >
            <path class="conn conn-1" d="M300 250 L300 190" />
            <path class="conn conn-2" d="M300 250 L200 300" />
            <path class="conn conn-3" d="M300 250 L400 300" />
            <path class="conn conn-4" d="M200 300 L200 370" />
            <path class="conn conn-5" d="M400 300 L400 370" />
            <path class="conn conn-6" d="M200 370 L300 430" />
            <path class="conn conn-7" d="M400 370 L300 430" />
            <path
              class="conn conn-8 conn-dashed"
              d="M300 250 L470 170"
              stroke-dasharray="4 6"
            />
            <circle class="data-packet packet-api" r="4" fill="#ffffff">
              <animateMotion
                dur="2.6s"
                repeatCount="indefinite"
                begin="3.2s"
                path="M300 250 L300 190 L200 300"
              />
            </circle>
            <circle class="data-packet packet-cloud" r="3.5" fill="#93c5fd">
              <animateMotion
                dur="3.8s"
                repeatCount="indefinite"
                begin="3.8s"
                path="M300 250 L400 300 L400 370 L300 430"
              />
            </circle>
            <circle class="data-packet packet-security" r="3" fill="#fbcfe8">
              <animateMotion
                dur="2.9s"
                repeatCount="indefinite"
                begin="4.4s"
                path="M300 250 L470 170"
              />
            </circle>
          </g>

          <g fill="#ec4899">
            <circle class="node node-1 node-pulse" cx="300" cy="250" r="3.5" />
            <circle class="node node-2" cx="300" cy="190" r="3" />
            <circle class="node node-3 node-pulse" cx="200" cy="300" r="3" />
            <circle class="node node-4" cx="400" cy="300" r="3" />
            <circle class="node node-5 node-pulse" cx="300" cy="430" r="3" />
            <circle class="node node-6" cx="470" cy="170" r="3" />
          </g>

          <g class="module module-top" filter="url(#softShadow)">
            <polygon
              points="300,160 340,180 300,200 260,180"
              fill="url(#gradWhite)"
            />
            <polygon points="260,180 300,200 300,220 260,200" fill="#e2e8f0" />
            <polygon
              points="300,200 340,180 340,200 300,220"
              fill="url(#gradNeutral)"
            />
          </g>
          <g class="module module-left" filter="url(#softShadow)">
            <polygon
              points="200,270 250,295 200,320 150,295"
              fill="url(#gradWhite)"
            />
            <polygon points="150,295 200,320 200,360 150,335" fill="#fbcfe8" />
            <polygon
              points="200,320 250,295 250,335 200,360"
              fill="url(#gradPink)"
            />
          </g>
          <g class="module module-right" filter="url(#softShadow)">
            <polygon
              points="400,270 450,295 400,320 350,295"
              fill="url(#gradWhite)"
            />
            <polygon points="350,295 400,320 400,360 350,335" fill="#e2e8f0" />
            <polygon
              points="400,320 450,295 450,335 400,360"
              fill="url(#gradNeutral)"
            />
          </g>
          <g class="module module-core" filter="url(#softShadow)">
            <polygon
              points="300,220 360,250 300,280 240,250"
              fill="url(#gradWhite)"
            />
            <polygon points="240,250 300,280 300,330 240,300" fill="#be185d" />
            <polygon
              points="300,280 360,250 360,300 300,330"
              fill="url(#gradMagenta)"
            />
          </g>
          <g class="module module-base" filter="url(#softShadow)">
            <polygon
              points="300,400 370,435 300,470 230,435"
              fill="url(#gradWhite)"
            />
            <polygon points="230,435 300,470 300,500 230,465" fill="#e2e8f0" />
            <polygon
              points="300,470 370,435 370,465 300,500"
              fill="url(#gradNeutral)"
            />
          </g>
          <g class="module module-satellite" filter="url(#softShadow)">
            <polygon
              points="470,150 500,165 470,180 440,165"
              fill="url(#gradPink)"
            />
            <polygon points="440,165 470,180 470,200 440,185" fill="#be185d" />
            <polygon
              points="470,180 500,165 500,185 470,200"
              fill="url(#gradMagenta)"
            />
          </g>
          <g class="core-pulse" fill="none" stroke="#f9a8d4" aria-hidden="true">
            <circle cx="300" cy="270" r="38" />
            <circle cx="300" cy="270" r="38" />
            <circle cx="300" cy="270" r="38" />
          </g>
        </svg>
      </div>
    </div>
  </div>

  <div class="relative z-10 w-full border-t border-slate-200/70 bg-white/45 backdrop-blur-xl">
    <div class="mx-auto w-full max-w-5xl px-6 py-8 sm:px-8">
      <div class="hero-fade hero-fade-6">
        <p class="mb-6 text-center text-xs font-semibold tracking-[0.18em] text-slate-500 uppercase">
          {t.stackLabel}
        </p>
        <div class="tech-grid mx-auto flex max-w-4xl flex-wrap items-center justify-center gap-x-8 gap-y-6 sm:gap-x-10">
          {techIcons.map((tech) => (
            <div
              class="tech-icon group relative flex h-10 w-10 items-center justify-center"
              title={tech.title}
              role="img"
              aria-label={tech.title}
            >
              <span class="tech-tooltip">{tech.title}</span>
              {tech.type === "fa" ? (
                <i
                  class={`${tech.icon} ${tech.color} text-3xl`}
                  aria-hidden="true"
                ></i>
              ) : tech.type === "inline" ? (
                <Fragment set:html={tech.svg} />
              ) : (
                <img
                  src={tech.src}
                  alt=""
                  width="32"
                  height="32"
                  loading="lazy"
                  class="h-8 w-8 object-contain"
                />
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-pattern {
    isolation: isolate;
    background: #fff;
  }
  .hero-grid {
    opacity: 0.42;
    background-image:
      linear-gradient(rgba(148, 163, 184, 0.11) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.11) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, black, transparent 75%);
  }
  .hero-noise {
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");
  }
  .hero-orb {
    filter: blur(4px);
    opacity: 0.58;
    background: radial-gradient(
      closest-side,
      rgba(236, 72, 153, 0.2),
      rgba(236, 72, 153, 0) 72%
    );
    animation: orbDrift 12s ease-in-out infinite alternate;
  }
  .hero-orb-two {
    opacity: 0.35;
    animation-delay: -5s;
    animation-duration: 16s;
  }
  .hero-fade {
    opacity: 0;
    transform: translateY(14px);
    animation: heroFadeUp 0.75s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  .hero-fade-1 {
    animation-delay: 0.05s;
  }
  .hero-fade-2 {
    animation-delay: 0.15s;
  }
  .hero-fade-3 {
    animation-delay: 0.28s;
  }
  .hero-fade-4 {
    animation-delay: 0.4s;
  }
  .hero-fade-5 {
    animation-delay: 0.52s;
  }
  .hero-fade-6 {
    animation-delay: 0.72s;
  }
  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #ec4899;
    box-shadow: 0 0 0 0 rgba(236, 72, 153, 0.45);
    animation: livePulse 2s infinite;
  }
  .title-shimmer {
    background: linear-gradient(110deg, #0f172a 20%, #be185d 45%, #0f172a 70%);
    background-size: 220% auto;
    color: transparent;
    background-clip: text;
    -webkit-background-clip: text;
    animation: shimmer 8s linear infinite;
  }
  .button-primary {
    box-shadow: 0 12px 30px -12px rgba(236, 72, 153, 0.72);
    transition:
      transform 0.3s,
      box-shadow 0.3s,
      background-color 0.3s;
  }
  .button-primary:hover {
    transform: translateY(-3px);
    background-color: #db2777;
    box-shadow: 0 18px 42px -14px rgba(236, 72, 153, 0.85);
  }
  .button-secondary {
    transition:
      transform 0.3s,
      border-color 0.3s,
      background-color 0.3s,
      box-shadow 0.3s;
  }
  .button-secondary:hover {
    transform: translateY(-3px);
    border-color: rgba(236, 72, 153, 0.35);
    background: white;
    box-shadow: 0 14px 35px -20px rgba(15, 23, 42, 0.35);
  }
  .hero-visual {
    min-height: 540px;
    display: grid;
    place-items: center;
  }
  .visual-glow {
    position: absolute;
    inset: 20% 16% 13%;
    border-radius: 50%;
    background: rgba(236, 72, 153, 0.16);
    filter: blur(50px);
    animation: glowBreath 5s ease-in-out infinite;
  }
  .architecture-svg {
    transform-origin: 50% 54%;
    animation: architectureSway 12s ease-in-out 1.8s infinite;
  }
  .ambient-rings {
    transform-origin: 300px 302px;
    animation: ringsRotate 24s linear infinite;
  }
  .orbit-two {
    animation: orbitDash 8s linear infinite reverse;
  }
  .core-ring {
    transform-origin: 300px 270px;
    transform-box: fill-box;
  }
  .core-ring-one {
    animation: ringExpand 3.8s ease-in-out infinite;
  }
  .core-ring-two {
    animation: ringExpand 3.8s ease-in-out 1.9s infinite;
  }
  .core-pulse circle {
    transform-origin: 300px 270px;
    transform-box: fill-box;
    stroke-width: 2;
    opacity: 0;
    animation: corePulse 4.5s ease-out infinite;
  }
  .core-pulse circle:nth-child(2) {
    animation-delay: 1.5s;
  }
  .core-pulse circle:nth-child(3) {
    animation-delay: 3s;
  }
  .floating-modules {
    font:
      700 8px/1 ui-monospace,
