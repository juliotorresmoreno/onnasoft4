---
const { language = Astro.url.pathname.split("/").filter(Boolean)[0] || "en" } =
  Astro.props;

const translations = {
  en: {
    eyebrow: "Technology Engineering",
    title: "Technology that moves your business forward.",
    subtitle:
      "We build software, connect systems and engineer technology solutions that solve real business problems — designed to grow and evolve with your business.",
    statement: "Fast to build. Solid to grow. Flexible to evolve.",
    ctaPrimary: "Contact OnnaSoft",
    ctaSecondary: "Explore our work",
    stackLabel: "Technologies we build solutions with",
  },
  es: {
    eyebrow: "Technology Engineering",
    title: "Tecnología que impulsa tu negocio.",
    subtitle:
      "Construimos software, conectamos sistemas y diseñamos soluciones tecnológicas que resuelven problemas reales de negocio — pensadas para crecer y evolucionar contigo.",
    statement:
      "Rápido de construir. Sólido para crecer. Flexible para evolucionar.",
    ctaPrimary: "Contacta a OnnaSoft",
    ctaSecondary: "Explora nuestro trabajo",
    stackLabel: "Tecnologías con las que construimos soluciones.",
  },
  fr: {
    eyebrow: "Technology Engineering",
    title: "La technologie qui fait avancer votre entreprise.",
    subtitle:
      "Nous construisons des logiciels, connectons des systèmes et concevons des solutions technologiques qui résolvent de vrais problèmes métier — pensées pour grandir et évoluer avec vous.",
    statement:
      "Rapide à construire. Solide pour grandir. Flexible pour évoluer.",
    ctaPrimary: "Contactez OnnaSoft",
    ctaSecondary: "Découvrez notre travail",
    stackLabel: "Technologies avec lesquelles nous construisons des solutions",
  },
  ja: {
    eyebrow: "Technology Engineering",
    title: "ビジネスを前進させるテクノロジー。",
    subtitle:
      "私たちは、実際のビジネス課題を解決するソフトウェアを構築し、システムを接続し、テクノロジーソリューションを設計します — ビジネスとともに成長し、進化するように作られています。",
    statement: "素早く構築。堅牢に成長。柔軟に進化。",
    ctaPrimary: "OnnaSoftに連絡",
    ctaSecondary: "実績を見る",
    stackLabel: "ソリューションを構築する技術",
  },
  zh: {
    eyebrow: "Technology Engineering",
    title: "推动业务前进的技术。",
    subtitle:
      "我们构建软件、连接系统并设计解决真实业务问题的技术方案 — 旨在随业务一同成长与演进。",
    statement: "快速构建。稳健成长。灵活演进。",
    ctaPrimary: "联系 OnnaSoft",
    ctaSecondary: "查看我们的作品",
    stackLabel: "我们构建解决方案所用的技术",
  },
};

const t =
  translations[language as keyof typeof translations] ?? translations.en;

type TechIcon =
  | { type: "fa"; icon: string; color: string; title: string }
  | { type: "svg"; src: string; title: string }
  | { type: "inline"; svg: string; title: string };

const techIcons: TechIcon[] = [
  {
    type: "svg",
    src: "https://cdn.simpleicons.org/typescript/3178C6",
    title: "TypeScript",
  },
  {
    type: "svg",
    src: "https://cdn.simpleicons.org/python/3776AB",
    title: "Python",
  },
  { type: "svg", src: "https://cdn.simpleicons.org/go/00ADD8", title: "Go" },
  {
    type: "fa",
    icon: "fab fa-node-js",
    color: "text-green-600",
    title: "Node.js",
  },
  { type: "fa", icon: "fab fa-react", color: "text-blue-400", title: "React" },
  {
    type: "svg",
    src: "https://cdn.simpleicons.org/nextdotjs/000000",
    title: "Next.js",
  },
  {
    type: "svg",
    src: "https://cdn.simpleicons.org/postgresql/4169E1",
    title: "PostgreSQL",
  },
  {
    type: "svg",
    src: "https://cdn.simpleicons.org/apachespark/E25A1C",
    title: "Apache Spark",
  },
  { type: "fa", icon: "fab fa-aws", color: "text-orange-500", title: "AWS" },
  {
    type: "fa",
    icon: "fab fa-docker",
    color: "text-blue-600",
    title: "Docker",
  },
  {
    type: "fa",
    icon: "fab fa-kubernetes",
    color: "text-blue-600",
    title: "Kubernetes",
  },
];
import HeroArchitecture from "./HeroArchitecture.astro";
---

<section
  id="home"
  class="hero-pattern relative isolate flex min-h-screen flex-col overflow-hidden"
  aria-labelledby="hero-title"
>
  <div
    class="hero-grid pointer-events-none absolute inset-0"
    aria-hidden="true"
  ></div>
  <div class="absolute inset-0 bg-linear-to-br from-white via-primary/10 to-fuchsia-50"></div>
  <div
    class="hero-orb hero-orb-one pointer-events-none absolute -top-48 right-[-12%] h-[680px] w-[680px] rounded-full"
    aria-hidden="true"
  ></div>
  <div
    class="hero-orb hero-orb-two pointer-events-none absolute bottom-[-18rem] left-[-12rem] h-[520px] w-[520px] rounded-full"
    aria-hidden="true"
  ></div>
  <div
    class="hero-noise pointer-events-none absolute inset-0"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 mx-auto grid w-full max-w-7xl flex-1 grid-cols-1 items-center gap-12 px-6 py-20 sm:px-8 lg:grid-cols-12 lg:gap-8 lg:py-24">
    <div class="lg:col-span-6 xl:col-span-6">
      <p class="hero-fade hero-fade-1 mb-5 inline-flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-primary uppercase">
        <span class="live-dot" aria-hidden="true"></span>
        {t.eyebrow}
      </p>

      <h1
        id="hero-title"
        class="hero-fade hero-fade-2 max-w-3xl text-4xl font-semibold leading-[1.04] tracking-tight text-slate-950 sm:text-5xl lg:text-[3.75rem] xl:text-6xl"
      >
        <span class="title-shimmer">{t.title}</span>
      </h1>

      <p class="hero-fade hero-fade-3 mt-6 max-w-xl text-base leading-relaxed text-slate-600 sm:text-lg">
        {t.subtitle}
      </p>

      <div class="hero-fade hero-fade-4 mt-9 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
        <a
          href={`/${language}/contact`}
          class="button-primary group inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-7 py-3.5 text-sm font-semibold text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          <span>{t.ctaPrimary}</span>
          <span
            class="transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true"
          >
            →
          </span>
        </a>
        <a
          href={`/${language}/work`}
          class="button-secondary group inline-flex items-center justify-center gap-2 rounded-xl border border-slate-200/80 bg-white/65 px-7 py-3.5 text-sm font-semibold text-slate-800 backdrop-blur-xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          <span>{t.ctaSecondary}</span>
          <span
            class="text-primary transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true"
          >
            ↗
          </span>
        </a>
      </div>

      <p class="hero-fade hero-fade-5 mt-10 max-w-md text-sm font-medium tracking-wide text-slate-500">
        <span class="mr-2 text-primary" aria-hidden="true">
          ✦
        </span>
        {t.statement}
      </p>
    </div>

    <div class="lg:col-span-6 xl:col-span-6">
      <div
        class="hero-visual relative mx-auto max-w-[580px]"
        aria-label="Interactive modular software architecture diagram"
      >
        <div class="visual-badge visual-badge-top">SYSTEMS / 01</div>
        <div class="visual-badge visual-badge-bottom">
          BUILD · CONNECT · EVOLVE
        </div>
        <div class="visual-glow" aria-hidden="true"></div>

        <img src="/Futuristic Fox with Holographic Tech Orbits.png" />
        {/*<HeroArchitecture />*/}
      </div>
    </div>
  </div>

  <div class="relative z-10 w-full border-t border-slate-200/70 bg-white/45 backdrop-blur-xl">
    <div class="mx-auto w-full max-w-5xl px-6 py-8 sm:px-8">
      <div class="hero-fade hero-fade-6">
        <p class="mb-6 text-center text-xs font-semibold tracking-[0.18em] text-slate-500 uppercase">
          {t.stackLabel}
        </p>
        <div class="tech-grid mx-auto flex max-w-4xl flex-wrap items-center justify-center gap-x-8 gap-y-6 sm:gap-x-10">
          {techIcons.map((tech) => (
            <div
              class="tech-icon group relative flex h-10 w-10 items-center justify-center"
              title={tech.title}
              role="img"
              aria-label={tech.title}
            >
              <span class="tech-tooltip">{tech.title}</span>
              {tech.type === "fa" ? (
                <i
                  class={`${tech.icon} ${tech.color} text-3xl`}
                  aria-hidden="true"
                ></i>
              ) : tech.type === "inline" ? (
                <Fragment set:html={tech.svg} />
              ) : (
                <img
                  src={tech.src}
                  alt=""
                  width="32"
                  height="32"
                  loading="lazy"
                  class="h-8 w-8 object-contain"
                />
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-pattern {
    isolation: isolate;
    background: #fff;
  }

  .hero-grid {
    opacity: 0.42;
    background-image:
      linear-gradient(rgba(148, 163, 184, 0.11) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.11) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, black, transparent 75%);
  }

  .hero-noise {
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");
  }

  .hero-orb {
    filter: blur(4px);
    opacity: 0.58;
    background: radial-gradient(
      closest-side,
      rgba(236, 72, 153, 0.2),
      rgba(236, 72, 153, 0) 72%
    );
    animation: orbDrift 12s ease-in-out infinite alternate;
  }

  .hero-orb-two {
    opacity: 0.35;
    animation-delay: -5s;
    animation-duration: 16s;
  }

  .hero-fade {
    opacity: 0;
    transform: translateY(14px);
    animation: heroFadeUp 0.75s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .hero-fade-1 {
    animation-delay: 0.05s;
  }

  .hero-fade-2 {
    animation-delay: 0.15s;
  }

  .hero-fade-3 {
    animation-delay: 0.28s;
  }

  .hero-fade-4 {
    animation-delay: 0.4s;
  }

  .hero-fade-5 {
    animation-delay: 0.52s;
  }

  .hero-fade-6 {
    animation-delay: 0.72s;
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #ec4899;
    box-shadow: 0 0 0 0 rgba(236, 72, 153, 0.45);
    animation: livePulse 2s infinite;
  }

  .title-shimmer {
    background: linear-gradient(110deg, #0f172a 20%, #be185d 45%, #0f172a 70%);
    background-size: 220% auto;
    color: transparent;
    background-clip: text;
    -webkit-background-clip: text;
    animation: shimmer 8s linear infinite;
  }

  .button-primary {
    box-shadow: 0 12px 30px -12px rgba(236, 72, 153, 0.72);
    transition:
      transform 0.3s,
      box-shadow 0.3s,
      background-color 0.3s;
  }

  .button-primary:hover {
    transform: translateY(-3px);
    background-color: #db2777;
    box-shadow: 0 18px 42px -14px rgba(236, 72, 153, 0.85);
  }

  .button-secondary {
    transition:
      transform 0.3s,
      border-color 0.3s,
      background-color 0.3s,
      box-shadow 0.3s;
  }

  .button-secondary:hover {
    transform: translateY(-3px);
    border-color: rgba(236, 72, 153, 0.35);
    background: white;
    box-shadow: 0 14px 35px -20px rgba(15, 23, 42, 0.35);
  }

  .hero-visual {
    min-height: 540px;
    display: grid;
    place-items: center;
  }

  .visual-glow {
    position: absolute;
    inset: 20% 16% 13%;
    border-radius: 50%;
    background: rgba(236, 72, 153, 0.16);
    filter: blur(50px);
    animation: glowBreath 5s ease-in-out infinite;
  }

  .visual-badge {
    position: absolute;
    z-index: 20;
    padding: 7px 10px;
    border: 1px solid rgba(236, 72, 153, 0.2);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.64);
    color: #9d174d;
    font:
      600 9px/1 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    letter-spacing: 0.16em;
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 20px -16px rgba(15, 23, 42, 0.65);
    animation: badgeFloat 5s ease-in-out infinite;
  }

  .visual-badge-top {
    top: 8%;
    right: 6%;
  }

  .visual-badge-bottom {
    bottom: 8%;
    left: 6%;
    animation-delay: -2.5s;
  }

  .tech-icon {
    opacity: 0.7;
    filter: grayscale(35%);
    transition:
      transform 0.3s,
      opacity 0.3s,
      filter 0.3s;
  }

  .tech-icon:hover {
    opacity: 1;
    filter: grayscale(0);
    transform: translateY(-5px) scale(1.12);
  }

  .tech-tooltip {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    z-index: 30;
    pointer-events: none;
    transform: translate(-50%, 4px);
    white-space: nowrap;
    border-radius: 6px;
    background: #0f172a;
    padding: 5px 7px;
    color: white;
    font-size: 10px;
    opacity: 0;
    transition:
      opacity 0.2s,
      transform 0.2s;
  }

  .tech-icon:hover .tech-tooltip {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (max-width: 640px) {
    .hero-visual {
      min-height: 420px;
      transform: scale(0.88);
      margin: -28px 0;
    }
    .visual-badge {
      font-size: 8px;
    }
    .hero-grid {
      background-size: 32px 32px;
    }
  }

  @keyframes heroFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes orbDrift {
    to {
      transform: translate3d(-35px, 24px, 0) scale(1.08);
    }
  }

  @keyframes livePulse {
    70% {
      box-shadow: 0 0 0 8px rgba(236, 72, 153, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(236, 72, 153, 0);
    }
  }

  @keyframes shimmer {
    to {
      background-position: 220% center;
    }
  }

  @keyframes glowBreath {
    50% {
      opacity: 0.72;
      transform: scale(1.08);
    }
  }

  @keyframes badgeFloat {
    50% {
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
    }
    .hero-fade {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>
