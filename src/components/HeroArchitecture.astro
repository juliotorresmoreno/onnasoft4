<!-- Isometric modular architecture illustration used in the Hero visual. -->
<svg
  viewBox="0 0 600 560"
  role="img"
  aria-label="Isometric diagram of a modular software architecture"
  class="architecture-svg relative z-10 h-auto w-full overflow-visible"
>
  <defs>
    <linearGradient id="gradPink" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#f9a8d4" />
      <stop offset="100%" stop-color="#ec4899" />
    </linearGradient>
    <linearGradient id="gradMagenta" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#ec4899" />
      <stop offset="100%" stop-color="#be185d" />
    </linearGradient>
    <linearGradient id="gradWhite" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#fce7f3" />
    </linearGradient>
    <linearGradient id="gradNeutral" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#f8fafc" />
      <stop offset="100%" stop-color="#e2e8f0" />
    </linearGradient>
    <filter
      id="softShadow"
      x="-30%"
      y="-30%"
      width="160%"
      height="180%"
    >
      <feDropShadow
        dx="0"
        dy="14"
        stdDeviation="12"
        flood-color="#be185d"
        flood-opacity="0.14"
      />
    </filter>
    <filter
      id="pinkGlow"
      x="-100%"
      y="-100%"
      width="300%"
      height="300%"
    >
      <feGaussianBlur stdDeviation="5" />
    </filter>
  </defs>

  <g
    class="ambient-rings"
    fill="none"
    stroke="#ec4899"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <ellipse
      class="orbit orbit-one"
      cx="300"
      cy="302"
      rx="204"
      ry="112"
      stroke-width="1"
      stroke-dasharray="2 13"
      opacity=".24"
    />
    <ellipse
      class="orbit orbit-two"
      cx="300"
      cy="302"
      rx="148"
      ry="82"
      stroke-width="1.5"
      stroke-dasharray="1 17"
      opacity=".2"
    />
    <circle
      class="core-ring core-ring-one"
      cx="300"
      cy="270"
      r="65"
      stroke-width="1"
      opacity=".22"
    />
    <circle
      class="core-ring core-ring-two"
      cx="300"
      cy="270"
      r="78"
      stroke-width="1"
      opacity=".12"
    />
  </g>
  <g class="floating-modules" aria-hidden="true">
    <g class="float-module float-module-api">
      <rect
        x="72"
        y="188"
        width="108"
        height="30"
        rx="8"
        fill="rgba(255,255,255,.84)"
        stroke="#f9a8d4"
        stroke-width="1"
      />
      <circle cx="86" cy="203" r="4" fill="#ec4899" />
      <text x="98" y="206" fill="#9d174d">
        SOFTWARE
      </text>
    </g>
    <g class="float-module float-module-data">
      <rect
        x="82"
        y="391"
        width="82"
        height="30"
        rx="8"
        fill="rgba(255,255,255,.78)"
        stroke="#cbd5e1"
        stroke-width="1"
      />
      <circle cx="95" cy="406" r="4" fill="#3b82f6" />
      <text x="107" y="409" fill="#475569">
        DATA
      </text>
    </g>
    <g class="float-module float-module-cloud">
      <rect
        x="450"
        y="319"
        width="112"
        height="30"
        rx="8"
        fill="rgba(255,255,255,.84)"
        stroke="#f9a8d4"
        stroke-width="1"
      />
      <circle cx="464" cy="334" r="4" fill="#ec4899" />
      <text x="476" y="337" fill="#9d174d">
        INTEGRATIONS
      </text>
    </g>
    <g class="float-module float-module-sec">
      <rect
        x="440"
        y="92"
        width="88"
        height="30"
        rx="8"
        fill="rgba(255,255,255,.84)"
        stroke="#f9a8d4"
        stroke-width="1"
      />
      <circle cx="454" cy="107" r="4" fill="#ec4899" />
      <text x="466" y="110" fill="#9d174d">
        INFRA
      </text>
    </g>
  </g>
  <ellipse
    cx="300"
    cy="478"
    rx="168"
    ry="28"
    fill="#ec4899"
    opacity="0.12"
    filter="url(#pinkGlow)"
  />
  <g
    class="connections"
    stroke="#ec4899"
    stroke-width="1.7"
    fill="none"
    stroke-linecap="round"
    opacity="0.7"
  >
    <path class="conn conn-1" d="M300 250 L300 190" />
    <path class="conn conn-2" d="M300 250 L200 300" />
    <path class="conn conn-3" d="M300 250 L400 300" />
    <path class="conn conn-4" d="M200 300 L200 370" />
    <path class="conn conn-5" d="M400 300 L400 370" />
    <path class="conn conn-6" d="M200 370 L300 430" />
    <path class="conn conn-7" d="M400 370 L300 430" />
    <path
      class="conn conn-8 conn-dashed"
      d="M300 250 L470 170"
      stroke-dasharray="4 6"
    />
    <circle class="data-packet packet-api" r="4" fill="#ffffff">
      <animateMotion
        dur="2.6s"
        repeatCount="indefinite"
        begin="3.2s"
        path="M300 250 L300 190 L200 300"
      />
    </circle>
    <circle class="data-packet packet-cloud" r="3.5" fill="#93c5fd">
      <animateMotion
        dur="3.8s"
        repeatCount="indefinite"
        begin="3.8s"
        path="M300 250 L400 300 L400 370 L300 430"
      />
    </circle>
    <circle class="data-packet packet-security" r="3" fill="#fbcfe8">
      <animateMotion
        dur="2.9s"
        repeatCount="indefinite"
        begin="4.4s"
        path="M300 250 L470 170"
      />
    </circle>
  </g>

  <g fill="#ec4899">
    <circle class="node node-1 node-pulse" cx="300" cy="250" r="3.5" />
    <circle class="node node-2" cx="300" cy="190" r="3" />
    <circle class="node node-3 node-pulse" cx="200" cy="300" r="3" />
    <circle class="node node-4" cx="400" cy="300" r="3" />
    <circle class="node node-5 node-pulse" cx="300" cy="430" r="3" />
    <circle class="node node-6" cx="470" cy="170" r="3" />
  </g>

  <g class="module module-top" filter="url(#softShadow)">
    <polygon
      points="300,160 340,180 300,200 260,180"
      fill="url(#gradWhite)"
    />
    <polygon points="260,180 300,200 300,220 260,200" fill="#e2e8f0" />
    <polygon
      points="300,200 340,180 340,200 300,220"
      fill="url(#gradNeutral)"
    />
  </g>
  <g class="module module-left" filter="url(#softShadow)">
    <polygon
      points="200,270 250,295 200,320 150,295"
      fill="url(#gradWhite)"
    />
    <polygon points="150,295 200,320 200,360 150,335" fill="#fbcfe8" />
    <polygon
      points="200,320 250,295 250,335 200,360"
      fill="url(#gradPink)"
    />
  </g>
  <g class="module module-right" filter="url(#softShadow)">
    <polygon
      points="400,270 450,295 400,320 350,295"
      fill="url(#gradWhite)"
    />
    <polygon points="350,295 400,320 400,360 350,335" fill="#e2e8f0" />
    <polygon
      points="400,320 450,295 450,335 400,360"
      fill="url(#gradNeutral)"
    />
  </g>
  <g class="module module-core" filter="url(#softShadow)">
    <polygon
      points="300,220 360,250 300,280 240,250"
      fill="url(#gradWhite)"
    />
    <polygon points="240,250 300,280 300,330 240,300" fill="#be185d" />
    <polygon
      points="300,280 360,250 360,300 300,330"
      fill="url(#gradMagenta)"
    />
  </g>
  <g class="module module-base" filter="url(#softShadow)">
    <polygon
      points="300,400 370,435 300,470 230,435"
      fill="url(#gradWhite)"
    />
    <polygon points="230,435 300,470 300,500 230,465" fill="#e2e8f0" />
    <polygon
      points="300,470 370,435 370,465 300,500"
      fill="url(#gradNeutral)"
    />
  </g>
  <g class="module module-satellite" filter="url(#softShadow)">
    <polygon
      points="470,150 500,165 470,180 440,165"
      fill="url(#gradPink)"
    />
    <polygon points="440,165 470,180 470,200 440,185" fill="#be185d" />
    <polygon
      points="470,180 500,165 500,185 470,200"
      fill="url(#gradMagenta)"
    />
  </g>
  <g class="core-pulse" fill="none" stroke="#f9a8d4" aria-hidden="true">
    <circle cx="300" cy="270" r="38" />
    <circle cx="300" cy="270" r="38" />
    <circle cx="300" cy="270" r="38" />
  </g>
</svg>

<style>
  .architecture-svg {
    transform-origin: 50% 54%;
    animation: architectureSway 12s ease-in-out 1.8s infinite;
  }

  .ambient-rings {
    transform-origin: 300px 302px;
    animation: ringsRotate 24s linear infinite;
  }

  .orbit-two {
    animation: orbitDash 8s linear infinite reverse;
  }

  .core-ring {
    transform-origin: 300px 270px;
    transform-box: fill-box;
  }

  .core-ring-one {
    animation: ringExpand 3.8s ease-in-out infinite;
  }

  .core-ring-two {
    animation: ringExpand 3.8s ease-in-out 1.9s infinite;
  }

  .core-pulse circle {
    transform-origin: 300px 270px;
    transform-box: fill-box;
    stroke-width: 2;
    opacity: 0;
    animation: corePulse 4.5s ease-out infinite;
  }

  .core-pulse circle:nth-child(2) {
    animation-delay: 1.5s;
  }

  .core-pulse circle:nth-child(3) {
    animation-delay: 3s;
  }

  .floating-modules {
    font:
      700 8px/1 ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
    letter-spacing: 0.1em;
  }

  .float-module {
    filter: drop-shadow(0 8px 7px rgba(15, 23, 42, 0.1));
    transform-box: fill-box;
    transform-origin: center;
    animation: floatModule 7s ease-in-out infinite;
  }

  .float-module-api {
    animation-delay: -0.8s;
  }

  .float-module-data {
    animation-delay: -2.2s;
  }

  .float-module-cloud {
    animation-delay: -3.6s;
  }

  .float-module-sec {
    animation-delay: -4.4s;
  }

  .data-packet {
    opacity: 0.2;
    filter: drop-shadow(0 0 5px rgba(236, 72, 153, 0.9));
    animation: packetGlow 2.6s ease-in-out infinite;
  }

  .packet-cloud {
    filter: drop-shadow(0 0 5px rgba(59, 130, 246, 0.9));
    animation-delay: -0.8s;
  }

  .packet-security {
    animation-delay: -1.5s;
  }

  .module {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    animation: moduleIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .module-top {
    animation-delay: 0.35s;
  }

  .module-left {
    animation-delay: 0.5s;
  }

  .module-right {
    animation-delay: 0.6s;
  }

  .module-core {
    animation:
      moduleIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.7s forwards,
      coreFloat 7s ease-in-out 1.6s infinite;
  }

  .module-base {
    animation-delay: 0.85s;
  }

  .module-satellite {
    animation:
      moduleIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) 1s forwards,
      satelliteFloat 5s ease-in-out 1.9s infinite;
  }

  .conn {
    stroke-dasharray: 120;
    stroke-dashoffset: 120;
    opacity: 0;
    animation: drawConn 1s ease-out forwards;
  }

  .conn-1 {
    animation-delay: 1.05s;
  }

  .conn-2 {
    animation-delay: 1.15s;
  }

  .conn-3 {
    animation-delay: 1.25s;
  }

  .conn-4 {
    animation-delay: 1.35s;
  }

  .conn-5 {
    animation-delay: 1.45s;
  }

  .conn-6 {
    animation-delay: 1.55s;
  }

  .conn-7 {
    animation-delay: 1.65s;
  }

  .conn-8 {
    animation-delay: 1.75s;
  }

  .data-particle {
    opacity: 0;
    animation: particleIn 1s ease-out 2s forwards;
  }

  .particle-2 {
    animation-delay: 2.4s;
  }

  .particle-3 {
    animation-delay: 2.8s;
  }

  .node {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: nodeIn 0.4s ease-out forwards;
  }

  .node-1 {
    animation-delay: 1.1s;
  }

  .node-2 {
    animation-delay: 1.2s;
  }

  .node-3 {
    animation-delay: 1.3s;
  }

  .node-4 {
    animation-delay: 1.4s;
  }

  .node-5 {
    animation-delay: 1.5s;
  }

  .node-6 {
    animation-delay: 1.6s;
  }

  .node-pulse {
    animation:
      nodeIn 0.4s ease-out forwards,
      nodePulse 3.5s ease-in-out 2.4s infinite;
  }

  @keyframes architectureSway {
    0%,
    100% {
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
    50% {
      transform: translate3d(0, -4px, 0) rotate(0.25deg);
    }
  }

  @keyframes ringsRotate {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes orbitDash {
    to {
      stroke-dashoffset: -72;
    }
  }

  @keyframes ringExpand {
    0%,
    100% {
      opacity: 0.12;
      transform: scale(0.96);
    }
    50% {
      opacity: 0.3;
      transform: scale(1.04);
    }
  }

  @keyframes corePulse {
    0% {
      opacity: 0.45;
      transform: scale(0.72);
    }
    75%,
    100% {
      opacity: 0;
      transform: scale(1.8);
    }
  }

  @keyframes floatModule {
    0%,
    100% {
      opacity: 0.8;
      transform: translate3d(0, 0, 0);
    }
    50% {
      opacity: 1;
      transform: translate3d(0, -6px, 0);
    }
  }

  @keyframes packetGlow {
    0%,
    100% {
      opacity: 0.45;
      transform: scale(0.85);
    }
    50% {
      opacity: 1;
      transform: scale(1.2);
    }
  }

  @keyframes moduleIn {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes coreFloat {
    50% {
      transform: translateY(-4px);
    }
  }

  @keyframes satelliteFloat {
    50% {
      transform: translateY(-5px) translateX(2px);
    }
  }

  @keyframes drawConn {
    to {
      stroke-dashoffset: 0;
      opacity: 0.7;
    }
  }

  @keyframes nodeIn {
    from {
      opacity: 0;
      transform: scale(0);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes nodePulse {
    50% {
      opacity: 0.55;
      transform: scale(1.35);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .architecture-svg,
    .ambient-rings,
    .core-ring,
    .core-pulse circle,
    .module,
    .conn,
    .node,
    .data-packet,
    .float-module {
      opacity: 1 !important;
      transform: none !important;
      stroke-dashoffset: 0 !important;
    }
  }
</style>
