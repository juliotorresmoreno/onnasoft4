                    "技术战略、软件架构、技术评估、业务现代化与数字化转型。",
            },
            {
                title: "技术人才解决方案",
                description:
                    "技术招聘、人才寻访、候选人筛选、技术评估及开发者招聘支持。",
            },
        ],
    },
};

const hrefs = [
    "/software-engineering/software-engineering-custom-scalable-software-solutions-for-your-business",
    "/cloud-devops/cloud-and-devops-automated-reliable-and-optimized-infrastructure",
    "/system-integration/system-integration-connect-your-platforms-and-exchange-data-seamlessly",
    "/ai-data-engineering/ai-and-data-engineering-turn-your-data-into-intelligent-automation",
    "/technology-consulting/technology-consulting-strategy-architecture-and-digital-transformation",
    "/technical-talent-solutions/technical-talent-solutions-hire-specialized-developers-and-tech-talent",
];

const icons = [
    "fa-solid fa-code",
    "fa-solid fa-cloud",
    "fa-solid fa-plug",
    "fa-solid fa-brain",
    "fa-solid fa-lightbulb",
    "fa-solid fa-users",
];

const t =
    translations[language as keyof typeof translations] ?? translations.en;
---

<section
    id="services"
    class="section bg-gray-50 dark:bg-gray-900 py-16 animate-fade-in-down"
>
    <div class="container mx-auto px-4">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-4 text-gray-900 dark:text-white">
                {t.title}
            </h2>
            <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
                {t.description}
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {t.services.map((service, index) => (
                <div class="bg-white dark:bg-gray-800 rounded-xl p-8 shadow-sm hover:shadow-lg transition-all duration-300 hover:scale-105 flex flex-col">
                    <div class="mb-5 p-4 bg-primary-light text-white rounded-full w-14 h-14 flex items-center justify-center">
                        <i
                            class={`${icons[index]} text-2xl`}
                            aria-hidden="true"
                        />
                    </div>

                    <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white">
                        {/*<a
                                href={`/${language}${hrefs[index]}`}
                                class="hover:underline"
                            >
                                {service.title}
                            </a>*/}
                        {service.title}
                    </h3>

                    <p class="text-gray-600 dark:text-gray-300">
                        {service.description}
                    </p>
                </div>
            ))}
        </div>
    </div>
</section>
