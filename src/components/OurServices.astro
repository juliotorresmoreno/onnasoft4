        ],
    },
    fr: {
        title: "Nos Services",
        description:
            "Nous transformons les défis commerciaux en solutions technologiques. Des logiciels personnalisés et des intégrations de systèmes à l'infrastructure cloud et à l'automatisation intelligente, nous aidons les entreprises à construire, améliorer et développer leurs opérations.",
        services: [
            {
                title: "Ingénierie Logicielle",
