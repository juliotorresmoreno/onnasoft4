      { title: "医疗保健", description: "为医疗行业提供改善患者管理、电子病历和临床数据分析的系统，以实现更高效的护理。", tags: ["远程医疗", "医院管理", "临床分析"], image: images.healthcare },
      { title: "教育", description: "互动式教育平台和数字学习工具，改变学生和教师的教育体验。", tags: ["在线学习", "学术管理", "评估"], image: images.education },
      { title: "电子商务", description: "开发在线商店、支付系统和库存管理平台，提升销售额并改善客户体验。", tags: ["电子商务", "在线支付", "数字营销"], image: images.ecommerce },
      { title: "房地产", description: "为房地产行业提供便捷的物业搜索、管理和维护应用，优化代理商和客户的流程。", tags: ["房地产", "智能家居", "物业管理"], image: images.realEstate },
      { title: "航空公司", description: "为航空行业提供全面解决方案，包括预订系统、航班管理和客户体验优化。", tags: ["航班管理", "预订系统", "客户体验"], image: images.airlines },
    ],
  },
};

const t = translations[language as keyof typeof translations] ?? translations.en;
---

<section id="projects" class="section animate-fade-in-down bg-white py-16 dark:bg-gray-900">
  <div class="container mx-auto px-4">
    <div class="mb-16 text-center">
      <h2 class="mb-4 text-3xl font-bold text-gray-900 dark:text-white md:text-4xl">
        {t.title}
      </h2>
      <p class="mx-auto max-w-2xl text-gray-600 dark:text-gray-300">
        {t.description}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {t.sectors.map((sector) => (
        <article class="group overflow-hidden rounded-xl shadow-sm transition-all duration-300 hover:scale-105 hover:shadow-lg">
          <div class="relative h-48">
            <img
              src={sector.image}
              alt={sector.title}
              class="h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-x-0 bottom-0 bg-black/50 p-4">
              <h3 class="text-center text-2xl font-bold text-white">
                {sector.title}
              </h3>
            </div>
          </div>

          <div class="bg-white p-6 dark:bg-gray-800">
            <p class="mb-4 text-gray-600 dark:text-gray-300">
              {sector.description}
            </p>
            <div class="flex flex-wrap gap-2">
              {sector.tags.map((tag) => (
                <span class="rounded-full bg-primary-light px-3 py-1 text-sm font-bold text-white">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href={`/${language}/contact`}
        class="inline-block rounded-lg bg-primary px-8 py-3 font-medium text-white transition-colors hover:bg-primary-dark"
      >
        {t.cta}
      </a>
    </div>
  </div>
</section>
