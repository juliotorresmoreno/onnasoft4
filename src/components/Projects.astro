      { title: "Immobilier", description: "Applications pour le secteur immobilier facilitant la recherche, la gestion et l'entretien des propriétés, optimisant les processus pour agents et clients.", tags: ["Immobilier", "Maison Intelligente", "Gestion Immobilière"], image: images.realEstate },
