      { title: "Aerolíneas", description: "Soluciones integrales para la industria aérea, incluyendo sistemas de reserva, gestión de vuelos y optimización de la experiencia del cliente.", tags: ["Gestión de Vuelos", "Sistemas de Reserva", "Experiencia del Cliente"], image: images.airlines },
    ],
  },
