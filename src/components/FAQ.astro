---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  language?: string;
}

const { language = Astro.url.pathname.split("/").filter(Boolean)[0] || "en" } =
    Astro.props;

const translations = {
  en: {
    title: "Frequently Asked Questions",
    subtitle:
      "Find answers to common questions about our services, process, and expertise. If you don't see what you're looking for, feel free to contact us directly.",
