{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "onnasoft4",
	"compatibility_date": "2026-10-29",
	"assets": {
		"directory": "./dist"
	},
	"observability": {
		"enabled": false
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "onnasoft-emdash",
			"database_id": "31148412-753d-4b86-b4c8-76f9c4dda708"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "onnasoft-emdash-media"
		}
	]
}