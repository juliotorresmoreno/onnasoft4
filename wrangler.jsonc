{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "onnasoft4",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./dist"
  },
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onnasoft-emdash"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "onnasoft-emdash-media"
    }
  ]
}